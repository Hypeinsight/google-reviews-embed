#!/bin/sh

# post-checkout hook
# Automatically updates CHANGE_LOG.md and TECH_STACK.md after branch checkout

echo "Running post-checkout hooks..."

# Update changelog
if ! node scripts/update_changelog.js; then
  echo "Warning: Failed to update changelog (non-fatal)"
fi

# Update tech stack
if ! node scripts/update_tech_stack.js; then
  echo "Warning: Failed to update tech stack (non-fatal)"
fi

exit 0
