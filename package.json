{
  "name": "google-reviews-embed",
  "version": "1.0.0",
  "description": "Scalable JavaScript Google Reviews embed system with multi-tenant support",
  "main": "dist/index.js",
  "scripts": {
    "demo": "tsx watch api/demo-server.ts",
    "dev": "tsx watch api/index.ts",
    "build": "tsc",
    "start": "node dist/api/index.js",
    "seed": "node scripts/seed_database.js",
    "postinstall": "node scripts/update_tech_stack.js",
    "init:hooks": "git config core.hooksPath .githooks && echo Git hooks configured successfully"
  },
  "keywords": [
    "google-reviews",
    "embed",
    "multi-tenant",
    "feedback"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
